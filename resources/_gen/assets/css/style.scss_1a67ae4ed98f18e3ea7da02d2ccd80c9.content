cent);border-radius:50%;box-shadow:0 0 14px var(--blog-accent)}.orbit-ring-outer{width:350px;border:1px dashed var(--blog-border);animation:orbit-spin 30s linear infinite}.orbit-ring-outer span{top:50%;left:-4px}.orbit-ring-inner{width:280px;border:1px solid transparent;border-top-color:var(--blog-pink);border-bottom-color:var(--blog-accent);opacity:0.65;animation:orbit-spin 21s linear infinite reverse}.orbit-ring-inner span{right:12%;bottom:8%;width:5px;height:5px;background:var(--blog-pink);box-shadow:0 0 14px var(--blog-pink)}.hero-avatar{position:relative;width:216px;aspect-ratio:1}.hero-avatar::before{position:absolute;inset:-18px;z-index:-1;content:"";background:conic-gradient(from 90deg, var(--blog-accent), transparent 35%, var(--blog-pink), transparent 72%, var(--blog-accent));border-radius:50%;filter:blur(20px);opacity:0.55;animation:avatar-aura 6s ease-in-out infinite}.hero-avatar img{width:100%;height:100%;margin:0;border:5px solid rgba(255,255,255,0.2);border-radius:50%;box-shadow:0 20px 60px rgba(0,0,0,0.18);object-fit:cover;animation:avatar-breathe 6s ease-in-out infinite}.hero-note{position:absolute;right:-0.25rem;bottom:2.75rem;display:flex;flex-direction:column;gap:0.25rem;padding:1rem 1.15rem;background:var(--blog-surface);border:1px solid var(--blog-border);border-radius:13px;box-shadow:var(--blog-shadow);backdrop-filter:blur(18px);animation:note-float 6s ease-in-out infinite}.hero-note>span{color:var(--blog-accent);font-family:Menlo, Monaco, Consolas, monospace;font-size:0.58rem;letter-spacing:0.14em}.hero-note strong{color:var(--blog-heading);font-size:0.86rem;font-weight:500}.hero-note>i{position:absolute;top:-14px;right:18px;display:grid;width:30px;height:30px;color:#15252d;font-size:0.75rem;background:var(--blog-accent);border-radius:50%;place-items:center}.home-discovery{position:relative;padding:1.8rem 2rem 1.65rem;overflow:hidden;background:var(--blog-surface);border:1px solid var(--blog-border);border-radius:20px;box-shadow:var(--blog-sha