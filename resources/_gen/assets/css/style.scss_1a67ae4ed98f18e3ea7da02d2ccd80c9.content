lor:var(--blog-accent)}.timeline-tools{max-width:1000px;margin:0 auto 1rem}.timeline-tools>summary{display:flex;align-items:center;justify-content:space-between;width:fit-content;min-width:112px;padding:0.4rem 0;color:var(--blog-muted);font-size:0.76rem;cursor:pointer;list-style:none;transition:color 160ms ease}.timeline-tools>summary::-webkit-details-marker{display:none}.timeline-tools>summary i{margin-right:0.3rem;font-size:0.6rem}.timeline-tools>summary kbd{margin-left:0.8rem;color:var(--blog-muted);font-family:Menlo, Monaco, Consolas, monospace;font-size:0.58rem}.timeline-tools>summary:hover,.timeline-tools>summary:focus-visible{color:var(--blog-accent)}.timeline-tools[open]>summary{color:var(--blog-accent)}.timeline-main,.timeline-stream,.timeline-entry,.timeline-entry-content{min-width:0}.timeline-main{max-width:1000px;margin:0 auto}.timeline-toolbar{position:relative;z-index:20;padding:0.35rem 0 0.65rem;border-top:1px solid var(--notes-line);border-bottom:1px solid var(--notes-line);animation:notes-menu-in 160ms ease-out both}.timeline-search{display:flex;align-items:center;gap:0.65rem;min-height:40px;border-bottom:1px solid var(--notes-line);transition:border-color 160ms ease}.timeline-search:focus-within{border-bottom-color:var(--blog-accent)}.timeline-search>i{color:var(--blog-muted);font-size:0.72rem}.timeline-search input{flex:1;min-width:0;padding:0.55rem 0;color:var(--blog-heading);font-family:inherit;font-size:0.84rem;background:transparent;border:0;outline:none;appearance:none}.timeline-search input::placeholder{color:var(--blog-muted)}.timeline-search input::-webkit-search-cancel-button{display:none}.timeline-search kbd{padding:0.05rem 0.35rem;color:var(--blog-muted);font-family:Menlo, Monaco, Consolas, monospace;font-size:0.62rem;background:transparent;border:1px solid var(--notes-line);border-radius:4px}.timeline-search button{padding:0.35rem;color:var(--blog-muted);font-size:0.72rem;background:transparent;border:0;cursor:pointer}.timeline-search 